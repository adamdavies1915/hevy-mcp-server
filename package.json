{
	"name": "hevy-mcp-server",
	"version": "3.1.0",
	"description": "A Model Context Protocol (MCP) server for the Hevy fitness tracking API, running on Node with the Hono framework",
	"type": "module",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"hevy",
		"fitness",
		"docker",
		"ai",
		"claude"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/tomtorggler/hevy-mcp-server.git"
	},
	"bugs": {
		"url": "https://github.com/tomtorggler/hevy-mcp-server/issues"
	},
	"homepage": "https://github.com/tomtorggler/hevy-mcp-server#readme",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev": "node --watch --experimental-strip-types src/server.ts",
		"format": "biome format --write",
		"lint:fix": "biome lint --fix",
		"start": "node dist/server.js",
		"type-check": "tsc --noEmit",
		"test": "vitest",
		"test:watch": "vitest --watch",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage",
		"test:run": "vitest run"
	},
	"dependencies": {
		"@hono/mcp": "^0.3.1",
		"@hono/node-server": "^2.0.12",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"better-sqlite3": "^12.11.1",
		"hono": "^4.10.1",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.5",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24.7.2",
		"@vitest/ui": "^3.2.4",
		"typescript": "5.9.3",
		"vitest": "^3.2.4"
	}
}
