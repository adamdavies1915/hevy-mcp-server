# GitHub OAuth App credentials
# Create one at https://github.com/settings/developers with:
#   Homepage URL:               https://your-domain
#   Authorization callback URL: https://your-domain/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Encrypts stored Hevy API keys and OAuth session cookies.
# Generate with: openssl rand -hex 32
COOKIE_ENCRYPTION_KEY=

# Hevy API key used when the signed-in user has not stored one via /setup.
# Get yours at https://hevy.com/settings?developer (requires Hevy Pro).
# Setting this REQUIRES ALLOWED_GITHUB_USERS, since every permitted user would
# otherwise share this one Hevy account.
HEVY_API_KEY=

# Comma-separated GitHub logins allowed to sign in.
# Leave empty only if you want anyone to sign in and store their own key.
ALLOWED_GITHUB_USERS=

# Port the server listens on (Coolify maps this to 443 via Traefik)
PORT=3000

# Where the SQLite KV database is written. Keep this on a mounted volume so
# sessions and stored API keys survive redeploys.
KV_PATH=/data/hevy-mcp.db
